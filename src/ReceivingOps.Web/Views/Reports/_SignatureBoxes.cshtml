@using System.Globalization
@model ReceivingOps.Web.Models.Dtos.DoPullHeader
@*
    3-party digital signature row (Customer / Warehouse / Production).
    Per-pull grain — the same set renders on every DO of the pull. Replaces the
    old 2-box footer (ISSUED/PICKED BY + APPROVED FOR DELIVERY BY) and the
    pull-close SignatureSvg display (decision #6).

    Signed   → drawn signature image + signer name + timestamp. All 3 parties
               carry a drawing now (Phase 8) and all 3 read it from the SAME
               source — their per-party PullSignatures row (p.SignatureSvg).
               Warehouse's row is populated at close (8a copies the close pad
               SVG into it; db/045 backfilled history), Customer/Production from
               the per-party sign pad (8b/8c). Pulls.SignatureSvg is no longer
               read here (8d uniform source).
    Unsigned → blank box; a "Sign as {Party}" button appears only when the
               current viewer is eligible (CanSign, set server-side to mirror
               the POST guards). reports.js delegates the click.
*@
@{
    var signedCount = Model.Signatures.All.Count(s => s.IsSigned);
}
@functions {
    // Only render an <img> for a PNG/JPEG data URL — the same constraint the PDF
    // export honours (System.Drawing can't rasterize inline SVG; raw SVG is also
    // an HTML-injection risk, so it is never emitted raw).
    static bool IsDrawing(string? svg) =>
        !string.IsNullOrEmpty(svg) &&
        svg.TrimStart().StartsWith("data:image", System.StringComparison.OrdinalIgnoreCase);
}
<div class="do-sign-row" data-pull-id="@Model.Id">
    @foreach (var p in Model.Signatures.All)
    {
        // 8d — uniform source: every box reads its own per-party row drawing.
        var partySvg = p.SignatureSvg;
        <div class="do-sign-box @(p.IsSigned ? "is-signed" : "")">
            <div class="do-sign-label">@p.Party.ToUpperInvariant()</div>
            <div class="do-sign-area">
                @if (p.IsSigned)
                {
                    @if (IsDrawing(partySvg))
                    {
                        <div class="do-sign-drawn"><img src="@partySvg" alt="Signature of @p.SignerName"></div>
                    }
                    <div class="do-sign-name">@p.SignerName</div>
                    <div class="do-sign-date mono">
                        @((p.SignedAt?.ToString("dd MMM yyyy · HH:mm", CultureInfo.InvariantCulture) ?? "") + " UTC")
                    </div>
                }
                else if (p.CanSign)
                {
                    <button type="button" class="do-sign-btn" data-party="@p.Party">
                        Sign as @p.Party
                    </button>
                }
            </div>
            <div class="do-sign-caption">Name / Date</div>
        </div>
    }
</div>
<div class="do-sign-complete @(signedCount == 3 ? "is-complete" : "")">
    @if (signedCount == 3)
    {
        <span><i class="bi bi-check-circle-fill"></i> Document complete — all 3 parties signed</span>
    }
    else
    {
        <span>@signedCount/3 signed · complete when all 3 parties sign</span>
    }
</div>
